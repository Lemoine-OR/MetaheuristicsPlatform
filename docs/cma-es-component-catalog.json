{
  "schemaVersion": 1,
  "release": "0.48.0",
  "family": "CMA-ES",
  "canonicalAlgorithmId": "cma-es-hansen-ostermeier-2001",
  "entries": [
    {
      "id": "cma.sampling.multivariate-normal",
      "name": "Multivariate normal offspring sampling",
      "status": "implemented",
      "reference": "Hansen & Ostermeier (2001)",
      "doi": "10.1162/106365601750190398",
      "formulaMode": "math",
      "formula": "x_k=m+\\sigma B D z_k,\\qquad z_k\\sim\\mathcal N(0,I)"
    },
    {
      "id": "cma.recombination.logarithmic-positive",
      "name": "Positive logarithmic recombination",
      "status": "implemented",
      "reference": "Hansen CMA-ES canonical defaults",
      "doi": "10.1162/106365601750190398",
      "formulaMode": "math",
      "formula": "w_i=\\frac{\\ln(\\mu+\\frac12)-\\ln i}{\\sum_{j=1}^{\\mu}(\\ln(\\mu+\\frac12)-\\ln j)},\\qquad \\mu_{\\mathrm{eff}}=\\frac{1}{\\sum_i w_i^2}"
    },
    {
      "id": "cma.path.cumulation",
      "name": "Evolution-path cumulation",
      "status": "implemented",
      "reference": "Hansen & Ostermeier (2001)",
      "doi": "10.1162/106365601750190398",
      "formulaMode": "math",
      "formula": "p_{\\sigma}\\leftarrow(1-c_{\\sigma})p_{\\sigma}+\\sqrt{c_{\\sigma}(2-c_{\\sigma})\\mu_{\\mathrm{eff}}}\\,C^{-1/2}\\frac{m^{+}-m}{\\sigma}"
    },
    {
      "id": "cma.step-size.csa",
      "name": "Cumulative step-size adaptation",
      "status": "implemented",
      "reference": "Hansen & Ostermeier (2001)",
      "doi": "10.1162/106365601750190398",
      "formulaMode": "math",
      "formula": "\\sigma\\leftarrow\\sigma\\exp\\!\\left(\\frac{c_{\\sigma}}{d_{\\sigma}}\\left(\\frac{\\lVert p_{\\sigma}\\rVert}{\\chi_n}-1\\right)\\right)"
    },
    {
      "id": "cma.covariance.rank-one",
      "name": "Rank-one covariance adaptation",
      "status": "implemented",
      "reference": "Hansen & Ostermeier (2001)",
      "doi": "10.1162/106365601750190398",
      "formulaMode": "math",
      "formula": "C\\leftarrow(1-c_1)C+c_1p_cp_c^{\\mathsf T}"
    },
    {
      "id": "cma.covariance.rank-mu",
      "name": "Rank-mu covariance adaptation",
      "status": "implemented",
      "reference": "Hansen, Muller & Koumoutsakos (2003)",
      "doi": "10.1162/106365603321828970",
      "formulaMode": "math",
      "formula": "C\\leftarrow C+c_{\\mu}\\sum_{i=1}^{\\mu}w_i y_{i:\\lambda}y_{i:\\lambda}^{\\mathsf T}"
    },
    {
      "id": "cma.covariance.active",
      "name": "Active covariance adaptation",
      "status": "implemented",
      "reference": "Hansen & Ros (2010); Jastrebski & Arnold (2006)",
      "doi": "10.1145/1830761.1830788",
      "formulaMode": "math",
      "formula": "C^+=\\left(1-c_1-c_{\\mu}\\sum_iw_i\\right)C+c_1p_cp_c^{\\mathsf T}+c_{\\mu}\\sum_iw_i^{\\circ}y_i y_i^{\\mathsf T}"
    },
    {
      "id": "cma.variant.separable",
      "name": "Separable CMA-ES",
      "status": "implemented",
      "reference": "Ros & Hansen (2008)",
      "doi": "10.1007/978-3-540-87700-4_30",
      "formulaMode": "math",
      "formula": "c_{jj}^+=\\left[1-c_{\\mathrm{cov}}+(1-h_{\\sigma})\\frac{c_{\\mathrm{cov}}}{\\mu_{\\mathrm{cov}}}c_c(2-c_c)\\right]c_{jj}+\\frac{c_{\\mathrm{cov}}}{\\mu_{\\mathrm{cov}}}(p_c)_j^2+c_{\\mathrm{cov}}\\left(1-\\frac{1}{\\mu_{\\mathrm{cov}}}\\right)\\sum_iw_i y_{i,j}^2"
    },
    {
      "id": "cma.restart.ipop",
      "name": "IPOP-CMA-ES restart strategy",
      "status": "implemented",
      "reference": "Auger & Hansen (2005)",
      "doi": "10.1109/CEC.2005.1554902",
      "formulaMode": "math",
      "formula": "\\lambda_r=\\rho_{\\mathrm{inc}}^r\\lambda_0,\\qquad \\rho_{\\mathrm{inc}}=2\\ \\mathrm{canonically}"
    },
    {
      "id": "cma.restart.bipop",
      "name": "BIPOP-CMA-ES restart strategy",
      "status": "implemented",
      "reference": "Hansen (2009)",
      "doi": "10.1145/1570256.1570333",
      "formulaMode": "math",
      "formula": "\\lambda_{\\mathrm{small}}=\\left\\lfloor\\lambda_0\\left(\\frac12\\frac{\\lambda_{\\mathrm{large}}}{\\lambda_0}\\right)^{U_1^2}\\right\\rfloor,\\qquad \\sigma_{\\mathrm{small}}^0=\\sigma_0 10^{-2U_2}"
    }
  ]
}
