PROJECT_NAME           = MetaheuristicsPlatform
PROJECT_BRIEF          = "High-performance scientific C# metaheuristics with a common generic architecture"
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = chtml
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3.2.2
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
RECURSIVE              = YES
NUM_PROC_THREADS       = 0
FILE_PATTERNS          = *.cs *.md
EXCLUDE_PATTERNS       = */bin/* */obj/*
EXTENSION_MAPPING      = cs=Csharp
FILTER_PATTERNS        = *.cs="powershell -NoProfile -ExecutionPolicy Bypass -File Doxygen-CSharpCompatibilityFilter.ps1"
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
HAVE_DOT               = YES
CLASS_GRAPH            = BUILTIN
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DIRECTORY_GRAPH        = NO
GRAPHICAL_HIERARCHY    = NO
DOT_GRAPH_MAX_NODES    = 40
MAX_DOT_GRAPH_DEPTH    = 2
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = doxygen-warnings.log
QUIET                  = NO
INPUT                   = ../src mainpage.md pages
OUTPUT_DIRECTORY        = ../Documentation/doxygen
HTML_EXTRA_STYLESHEET   = doxygen-custom.css
PROJECT_LOGO            = assets/metaheuristicsplatform-logo.svg
