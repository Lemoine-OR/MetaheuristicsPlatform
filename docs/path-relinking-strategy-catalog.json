{
  "schemaVersion": 1,
  "release": "0.32.0",
  "component": "Path Relinking strategies",
  "implementedCount": 7,
  "reviewedDeferredCount": 0,
  "implemented": [
    {
      "id": "pr.forward",
      "name": "Forward path relinking",
      "kind": "direction",
      "formulaMode": "math",
      "formula": "x^I \\rightarrow x^G",
      "status": "implemented"
    },
    {
      "id": "pr.backward",
      "name": "Backward path relinking",
      "kind": "direction",
      "formulaMode": "math",
      "formula": "x^G \\rightarrow x^I",
      "status": "implemented"
    },
    {
      "id": "pr.back-and-forward",
      "name": "Back-and-forward path relinking",
      "kind": "direction",
      "formulaMode": "math",
      "formula": "P_{BF}=P(x^G,x^I)\\cup P(x^I,x^G)",
      "status": "implemented"
    },
    {
      "id": "pr.mixed",
      "name": "Mixed path relinking",
      "kind": "direction",
      "formulaMode": "math",
      "formula": "x^I_{k+1}\\rightarrow x^G_k,\\quad x^G_{k+1}\\rightarrow x^I_{k+1}\\quad\\text{alternately}",
      "status": "implemented"
    },
    {
      "id": "pr.truncated",
      "name": "Truncated path relinking",
      "kind": "orthogonal-path-fraction",
      "formulaMode": "math",
      "formula": "\\rho_0-\\rho_k\\ge\\lceil\\theta\\rho_0\\rceil,\\quad 0<\\theta\\le1",
      "status": "implemented"
    },
    {
      "id": "pr.greedy-randomized-adaptive",
      "name": "Greedy-randomized adaptive path relinking",
      "kind": "move-selection",
      "formulaMode": "math",
      "formula": "RCL_\\alpha=\\{m:f_m\\le f_{best}+\\alpha(f_{worst}-f_{best})\\}",
      "status": "implemented"
    },
    {
      "id": "pr.evolutionary",
      "name": "Evolutionary path relinking",
      "kind": "elite-population-evolution",
      "formulaMode": "math",
      "formula": "P^{k+1}=\\operatorname{Elite}\\!\\left(\\{PR(x_i^k,x_j^k):1\\le i<j\\le|P^k|\\}\\right)",
      "status": "implemented"
    }
  ],
