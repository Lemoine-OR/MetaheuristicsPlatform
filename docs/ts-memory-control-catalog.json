      "id": "ts.memory.short-term.expiration",
      "name": "Expiration-based short-term tabu memory",
      "availability": "implemented",
      "category": "memory",
      "implementationClass": "ExpirationTabuMemory<TAttribute>",
      "sourcePath": "src/MetaheuristicsPlatform/Algorithms/TS/ExpirationTabuMemory.cs",
      "scope": "Short-term recency memory with expected constant-time lookup and ordered expiration.",
      "formula": "a\\in T_k \\iff e(a)\\ge k",
      "complexity": "Expected O(1) lookup; O(log M) registration; amortized ordered expiration.",
      "parameters": "initial capacity; optional equality comparer",
      "reference": "Glover (1989, 1990)",
      "doi": "10.1287/ijoc.1.3.190",
      "source": "Glover, Tabu Search-Part I/II"
    },
    {
      "id": "ts.memory.frequency.attribute",
      "name": "Attribute frequency memory",
      "availability": "implemented",
      "category": "memory",
      "implementationClass": "AttributeFrequencyMemory<TAttribute>",
      "sourcePath": "src/MetaheuristicsPlatform/Algorithms/TS/AttributeFrequencyMemory.cs",
      "scope": "Long-term frequency counts for domain-defined candidate attributes.",
      "formula": "F_k(a)=\\sum_{j=1}^{k}\\mathbf 1\\{a_j=a\\}",
      "complexity": "Expected O(1) lookup/update.",
      "parameters": "initial capacity; optional equality comparer",
      "reference": "Glover (1989); Glover & Laguna (1997)",
      "doi": "10.1287/ijoc.1.3.190",
