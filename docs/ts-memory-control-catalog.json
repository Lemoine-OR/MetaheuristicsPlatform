    },
    {
      "id": "ts.tenure.uniform-random",
      "name": "Uniformly varying tabu tenure",
      "availability": "implemented",
      "category": "tenure",
      "implementationClass": "UniformRandomTabuTenurePolicy",
      "sourcePath": "src/MetaheuristicsPlatform/Algorithms/TS/UniformRandomTabuTenurePolicy.cs",
      "scope": "Random tenure in a configured inclusive interval.",
      "formula": "\\tau_k\\sim\\mathcal U_{\\mathbb Z}[\\tau_{\\min},\\tau_{\\max}]",
      "complexity": "O(1) per selected move.",
      "parameters": "minimum and maximum tenure",
      "reference": "Glover (1990)",
      "doi": "10.1287/ijoc.2.1.4",
      "source": "Dynamic tabu-list management"
    },
    {
      "id": "ts.tenure.reactive-battiti-tecchiolli-1994",
      "name": "Reactive tabu tenure",
      "availability": "implemented",
      "category": "tenure",
      "implementationClass": "ReactiveTabuTenurePolicy",
      "sourcePath": "src/MetaheuristicsPlatform/Algorithms/TS/ReactiveTabuTenurePolicy.cs",
      "scope": "Feedback tenure grows on detected repetition and decreases after repetition-free search.",
      "formula": "\\tau_{k+1}=\\operatorname{clip}(\\rho_+\\tau_k)\\ \\text{on repetition};\\quad \\tau_{k+1}=\\operatorname{clip}(\\rho_-\\tau_k)\\ \\text{after sustained non-repetition}",
      "complexity": "O(1) feedback update.",
      "parameters": "min/max/initial tenure; increase/decrease factors; decrease interval",
      "reference": "Battiti & Tecchiolli (1994)",
      "doi": "10.1287/ijoc.6.2.126",
      "source": "Reactive Tabu Search"
    },
    {
