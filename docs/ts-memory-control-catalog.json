      "name": "Fixed tabu tenure",
      "availability": "implemented",
      "category": "tenure",
      "implementationClass": "FixedTabuTenurePolicy",
      "sourcePath": "src/MetaheuristicsPlatform/Algorithms/TS/FixedTabuTenurePolicy.cs",
      "scope": "Constant short-term prohibition period.",
      "formula": "\\tau_k=\\tau",
      "complexity": "O(1) per selected move.",
      "parameters": "positive fixed tenure",
      "reference": "Glover (1989)",
      "doi": "10.1287/ijoc.1.3.190",
